@model SistemaLoginMVC.Models.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center vh-100">
    <div class="card shadow-sm p-4" style="width: 100%; max-width: 400px;">
        <h3 class="text-center text-primary mb-4">Control de Acceso</h3>

        @if (ViewData["MensajeError"] != null)
        {
            <div class="alert alert-danger text-center" role="alert">
                @ViewData["MensajeError"]
            </div>
        }

        <form asp-controller="Acceso" asp-action="Login" method="post">
            <div class="mb-3">
                <label class="form-label">Correo Electrónico</label>
                <input type="email" class="form-control" asp-for="Correo" placeholder="usuario@correo.com" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <input type="password" class="form-control" asp-for="Password" placeholder="Ingresa tu contraseña" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">Iniciar Sesión</button>
        </form>
    </div>
</body>
</html>